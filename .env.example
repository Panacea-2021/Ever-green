# ============================================
# Evergreen Frontend Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.
# Never commit .env with real credentials to version control.

# ============================================
# API Configuration
# ============================================

# Backend API Base URL
# Development: http://localhost:3000/
# Production: https://evergreen-backend-lgmy.onrender.com/
API_BASE_URL=http://localhost:3000/

# API Key for authentication endpoints (signIn, forgetPassword)
# Must match NODE_API_KEY in backend .env
API_KEY=

# ============================================
# Network Timeouts (in milliseconds)
# ============================================

# Connection timeout - time to establish connection
CONNECTION_TIMEOUT=60000

# Receive timeout - time to receive response
RECEIVE_TIMEOUT=60000

# ============================================
# Environment Mode
# ============================================

# Options: dev, staging, prod
ENVIRONMENT=dev

# Enable debug logging (true/false)
ENABLE_LOGGING=true

# ============================================
# Firebase Configuration (Push Notifications)
# ============================================

# Firebase Project Configuration
# Get these from Firebase Console > Project Settings > General

# Android
FIREBASE_ANDROID_API_KEY=
FIREBASE_ANDROID_APP_ID=
FIREBASE_ANDROID_MESSAGING_SENDER_ID=
FIREBASE_ANDROID_PROJECT_ID=
FIREBASE_ANDROID_STORAGE_BUCKET=

# iOS
FIREBASE_IOS_API_KEY=
FIREBASE_IOS_APP_ID=
FIREBASE_IOS_MESSAGING_SENDER_ID=
FIREBASE_IOS_PROJECT_ID=
FIREBASE_IOS_STORAGE_BUCKET=
FIREBASE_IOS_BUNDLE_ID=

# Web
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_STORAGE_BUCKET=

# ============================================
# Feature Flags
# ============================================

# Show debug information in UI (true/false)
FEATURE_SHOW_DEBUG_INFO=true

# Enable analytics tracking (true/false)
FEATURE_ENABLE_ANALYTICS=false

# Enable crash reporting (true/false)
FEATURE_ENABLE_CRASH_REPORTING=false

# ============================================
# App Information
# ============================================

# App Name displayed in the application
APP_NAME=Evergreen

# ============================================
# Deep Linking / URL Scheme
# ============================================

# Custom URL scheme for deep linking
URL_SCHEME=evergreen

# Web app base URL (for sharing links)
WEB_APP_URL=http://localhost:8080

# ============================================
# Development Settings
# ============================================

# Mock API responses for testing (true/false)
USE_MOCK_API=false

# Enable hot reload preservation of state (true/false)
PRESERVE_STATE_ON_HOT_RELOAD=true
